# Starknet RPC endpoint
STARKNET_RPC_URL=http://ip:port/rpc/v0_10

# Funded account address on the test network
STARKNET_ACCOUNT_ADDRESS=0x...

# Private key for the account (KEEP SECRET)
STARKNET_PRIVATE_KEY=0x...

# Optional sequencer gateway URL for proof submission.
# Counter/messages e2e can fall back to RPC; CoinFlip settlement/playground paths expect it.
# STARKNET_GATEWAY_URL=https://alpha-sepolia.starknet.io

# Chain ID (default: SN_SEPOLIA)
# STARKNET_CHAIN_ID=SN_SEPOLIA

# Optional remote prover JSON-RPC endpoint for E2E and playground proving.
# The standalone prove command uses --prover-url instead.
# PROVER_URL=http://prover:9900

# Optional STRK fee-token address override (needed on custom networks/devnets).
# STARKNET_STRK_TOKEN=0x...

# Optional project root override for output/, deps/, scripts/, and contracts.
# SNIP36_PROJECT_DIR=/absolute/path/to/snip36prover

# Playground-only overrides (defaults: playground-master and port 8090).
# SNCAST_ACCOUNT=playground-master
# PORT=8090
