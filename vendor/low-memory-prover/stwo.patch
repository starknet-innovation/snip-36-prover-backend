+    component_polys[PREPROCESSED_TRACE_IDX] = component
+        .preprocessed_column_indices
+        .iter()
+        .map(|idx| &trace.polys[PREPROCESSED_TRACE_IDX][*idx])
+        .collect();
+    component_polys
+}
